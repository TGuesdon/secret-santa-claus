{
  "name": "secret-santa-claus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsx --env-file-if-exists=.env scripts/check-dist.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "preview": "vite preview",
    "santa:demo": "tsx --env-file-if-exists=.env scripts/cli.ts demo",
    "santa:prepare": "tsx --env-file-if-exists=.env scripts/cli.ts prepare",
    "santa:check": "tsx --env-file-if-exists=.env scripts/cli.ts check",
    "santa:mail": "tsx --env-file-if-exists=.env scripts/cli.ts mail",
    "santa:mail:test": "tsx --env-file-if-exists=.env scripts/test-mail.ts",
    "santa:archive:export": "tsx --env-file-if-exists=.env scripts/export-archive.ts",
    "santa:resolve": "tsx --env-file-if-exists=.env scripts/cli.ts resolve",
    "santa:key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\""
  },
  "dependencies": {
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "mailparser": "^3.14.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
