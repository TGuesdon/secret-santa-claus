# Copy to .env. Real values belong in this ignored file or GitHub configuration.
PUBLIC_BASE_URL=http://localhost:5173/
SANTA_SENDER_EMAIL=santa.claus.trassaert@gmail.com

# Generate once with npm run santa:key, save privately and keep a backup.
SANTA_ARCHIVE_KEY=

# Gmail SMTP
GOOGLE_APPLICATION_PASSWORD=

# Alternatively, use santa:prepare -- --participants .private/participants.json.
# Optional participant field: "exclusions":["Michel"] forbids Alice from drawing Michel.
# Exclusions reference names in the same campaign and only apply in that direction.
# SANTA_PARTICIPANTS_JSON={"family-2026":[{"name":"Alice","email":"alice@example.com","exclusions":["Michel"]},{"name":"Bob","email":"bob@example.com"},{"name":"Stan","email":"stan@example.com"},{"name":"Michel","email":"michel@example.com"}]}
